# Evo Hawks Production Environment Configuration

# Direct Form & Brief Delivery Endpoint
# Default fallback: https://formsubmit.co/ajax/teamevohawks@gmail.com
VITE_CONTACT_FORM_ENDPOINT=https://formsubmit.co/ajax/teamevohawks@gmail.com

# Optional: Cal.com / Calendly Direct Booking URL (e.g., https://cal.com/evohawks/30min)
# VITE_CAL_BOOKING_URL=

# Supabase Cloud Sync (Syncs Admin Panel customizations across all devices & live website)
# Obtain from: Supabase Project Settings -> API -> Project URL & Project API Keys (anon / public)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
